<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Preview, not production ready. Microsoft Agent Framework (MAF) adapter for AgentExperience.NET: one AIAgentBuilder.UseExperienceCapture(...) call records every MAF invocation (ordinary, streaming, failed, cancelled, or abandoned mid-stream) and its tool calls as a sanitized Experience Run through AgentExperience.Core's IExperienceCaptureService. Pinned to Microsoft.Agents.AI 1.22.0.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The one exact pin left (story 6.3): MAF compatibility is verified against this version only (Story 1.7
         Track 1, Story 1.6). MAF ships a minor release every week or two, has changed adapter-visible behaviour between
         minors, and still marks neighbouring surface [Experimental], so a floor would claim versions nobody has
         run. CI's MAF probe reports on the newest one; docs/compatibility-evidence.md has the reasoning. -->
    <PackageReference Include="Microsoft.Agents.AI" Version="[1.22.0]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentExperience.Core\AgentExperience.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentExperience.MicrosoftAgentFramework.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
