<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Preview, not production ready. Microsoft Agent Framework (MAF) adapter for AgentExperience.NET: one AIAgentBuilder.UseExperienceCapture(...) call records every MAF invocation (ordinary, streaming, failed, cancelled, or abandoned mid-stream) and its tool calls as a sanitized Experience Run through AgentExperience.Core's IExperienceCaptureService, and an ExperienceContextProvider injects the verified lessons that apply before the model is called. With services.AddAgentExperience(...), one AIAgentBuilder.UseAgentExperience(services) call wires both. Requires Microsoft.Agents.AI 1.22.0 or any later 1.x, and Microsoft.Extensions.Hosting.Abstractions 10.0.3 or later within the same major.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- A tested range, not a bare floor (story 7.2, KL-13): 1.22.0 up to, but not including, 2.0.0. The floor is
         what the committed lock files resolve and every test runs; the newest 1.x is proven by CI's MAF probe
         (latest leg) and floating-dependency leg, which both gate pushes and the weekly schedule. The upper bound
         is MAF's next major: MAF states no SemVer promise and shipped five caller-visible behaviour changes between
         1.15 and 1.22, so a major is where a break is expected, and a host on it is told (NU1608) rather than
         silently run against an adapter nobody built for it. A newer 1.x minor restores with no warning.
         docs/compatibility-evidence.md has the evidence. -->
    <PackageReference Include="Microsoft.Agents.AI" Version="[1.22.0, 2.0.0)" />
    <!-- Story 21.1: a floor, like the in-memory store's. Supplies IHostEnvironment, which the development identity's
         environment guard reads (the same rule as the in-memory store, linked below). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentExperience.Core\AgentExperience.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentExperience.MicrosoftAgentFramework.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);AGENTEXPERIENCE_MAF</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared source (story 14.3): the model-authored content guard's patterns, linked into Core and the MAF
         adapter so both agree on what a link is. -->
    <Compile Include="..\Shared\ModelTextPatterns.Shared.cs" Link="Shared\ModelTextPatterns.Shared.cs" />
    <!-- Story 17.1: the one rule that decides whether a reflection counts as model-authored, shared by Core, the MAF
         adapter and both stores so every authorship decision agrees. -->
    <Compile Include="..\Shared\ReflectionAuthorshipRule.Shared.cs" Link="Shared\ReflectionAuthorshipRule.Shared.cs" />
    <!-- Story 18.1: the one rule that reduces a captured error to a short class, shared by the default reflector's
         lesson and the injected block's Tried: lines so both name a failure the same way. -->
    <Compile Include="..\Shared\ErrorClass.Shared.cs" Link="Shared\ErrorClass.Shared.cs" />
    <!-- Story 18.2: the default reflector's wording the compact block leaves out, written by one and matched by the other. -->
    <Compile Include="..\Shared\DefaultReflectionText.Shared.cs" Link="Shared\DefaultReflectionText.Shared.cs" />
    <!-- Story 21.1: the development-or-test environment rule the in-memory store uses, so the development identity
         refuses exactly the environments that store refuses. -->
    <Compile Include="..\Shared\DevelopmentEnvironment.Shared.cs" Link="Shared\DevelopmentEnvironment.Shared.cs" />
  </ItemGroup>

</Project>
