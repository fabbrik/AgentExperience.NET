<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Preview, not production ready. Microsoft Agent Framework (MAF) adapter for AgentExperience.NET: one AIAgentBuilder.UseExperienceCapture(...) call records every MAF invocation (ordinary, streaming, failed, cancelled, or abandoned mid-stream) and its tool calls as a sanitized Experience Run through AgentExperience.Core's IExperienceCaptureService. Pinned to Microsoft.Agents.AI 1.20.0.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exact pin: MAF compatibility is verified against this version only (Story 1.7 Track 1, Story 1.6). -->
    <PackageReference Include="Microsoft.Agents.AI" Version="[1.20.0]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentExperience.Core\AgentExperience.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentExperience.MicrosoftAgentFramework.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
