<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Preview, not production ready. Adapter-independent domain contracts for AgentExperience.NET: Experience Runs, Attempts, Outcomes, Evidence, Reflections, Scope, Environment, lifecycle events, and the sanitization port. No dependency on MAF, EF Core, PostgreSQL, model providers, or OpenTelemetry.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);AGENTEXPERIENCE_ABSTRACTIONS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Story 28.2: the error classifier the default reflector and the injected block share, so a failure signature's
         error class is the very token a call's "[failed: …]" marker shows. -->
    <Compile Include="..\Shared\ErrorClass.Shared.cs" Link="Shared\ErrorClass.Shared.cs" />
  </ItemGroup>

</Project>
