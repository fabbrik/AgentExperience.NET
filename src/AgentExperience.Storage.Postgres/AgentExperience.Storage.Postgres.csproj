<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Preview, not production ready. PostgreSQL adapter for AgentExperience.NET: persists canonical, scoped Experience Records through the IExperienceRecordStore port with plain Npgsql, host-authorization checks before any database access, exact scope predicates applied in SQL, and a journaled schema migration runner over embedded, versioned scripts. Requires Npgsql 10.0.3, dbup-postgresql 7.0.1, and dbup-core 6.1.1 or later within the same major.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Selects this package's namespace in the shared validation rules linked below (story 11.2). -->
    <DefineConstants>$(DefineConstants);AGENTEXPERIENCE_POSTGRES</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Floors, not exact pins (story 6.3, KL-13): the version CI proves, and the lowest a host can resolve.
         CI's floating leg also proves the newest release in the same major; docs/compatibility-evidence.md
         states the policy. -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <!-- Journaled schema migrations. -->
    <PackageReference Include="dbup-postgresql" Version="7.0.1" />
    <!-- dbup-postgresql's own dependency, referenced directly so the floor is explicit. Move the two DbUp floors
         in lockstep, to the dbup-core version the new dbup-postgresql depends on; DependencyBoundaryTests
         asserts this exact set of PackageReferences. -->
    <PackageReference Include="dbup-core" Version="6.1.1" />
    <!-- DI abstractions only (no container, no hosting): lets this adapter ship its own
         AddAgentExperiencePostgresStore registration extension. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentExperience.Abstractions\AgentExperience.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\0001_create_experience_records.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0001_create_experience_records.sql" />
    <EmbeddedResource Include="Migrations\0002_create_lifecycle_events.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0002_create_lifecycle_events.sql" />
    <EmbeddedResource Include="Migrations\0003_add_experience_search.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0003_add_experience_search.sql" />
    <!-- 0004 is owned by AgentExperience.Storage.Postgres.Vectors, which applies it separately: it needs
         CREATE EXTENSION vector and must not become a startup requirement for text-only hosts. -->
    <EmbeddedResource Include="Migrations\0005_create_experience_grants.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0005_create_experience_grants.sql" />
    <EmbeddedResource Include="Migrations\0006_lifecycle_supersession_and_append_only.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0006_lifecycle_supersession_and_append_only.sql" />
    <EmbeddedResource Include="Migrations\0007_confidence_evidence.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0007_confidence_evidence.sql" />
    <EmbeddedResource Include="Migrations\0008_reuse_feedback.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0008_reuse_feedback.sql" />
    <EmbeddedResource Include="Migrations\0009_grant_access_log.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0009_grant_access_log.sql" />
    <EmbeddedResource Include="Migrations\0010_delete_and_expire.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0010_delete_and_expire.sql" />
    <EmbeddedResource Include="Migrations\0011_grant_disclosure.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0011_grant_disclosure.sql" />
    <EmbeddedResource Include="Migrations\0012_grant_access_retention.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0012_grant_access_retention.sql" />
    <EmbeddedResource Include="Migrations\0013_role_separation_hardening.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0013_role_separation_hardening.sql" />
    <EmbeddedResource Include="Migrations\0015_verified_independence.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0015_verified_independence.sql" />
    <EmbeddedResource Include="Migrations\0016_crypto_shredding.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0016_crypto_shredding.sql" />
    <EmbeddedResource Include="Migrations\0017_grant_argument_disclosure.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0017_grant_argument_disclosure.sql" />
    <EmbeddedResource Include="Migrations\0018_evidence_admission.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0018_evidence_admission.sql" />
    <EmbeddedResource Include="Migrations\0019_row_level_security.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0019_row_level_security.sql" />
    <EmbeddedResource Include="Migrations\0021_reflection_authorship.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0021_reflection_authorship.sql" />
    <EmbeddedResource Include="Migrations\0022_library_reflector_authorship.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0022_library_reflector_authorship.sql" />
    <EmbeddedResource Include="Migrations\0023_recorded_only_evidence.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0023_recorded_only_evidence.sql" />
    <EmbeddedResource Include="Migrations\0024_text_search_function.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0024_text_search_function.sql" />
    <EmbeddedResource Include="Migrations\0025_text_search_any_term.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0025_text_search_any_term.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentExperience.Storage.Postgres.Tests" />
    <!-- The vectors package is the same adapter family, split out only because this package's
         dependency boundary forbids Pgvector and the model-provider abstractions it needs. It reuses
         this package's shared SQL (ExperienceRecordSql: table, columns, live, scope and grant fragments),
         row decoder (ExperienceRecordRows), parameter binding (ExperienceRecordParameters) and failure
         translation (ExperienceStoreFailures), so the two retrieval channels cannot drift apart. It also
         shares the record keys (ExperienceEncryption, RecordKey), the row-level-security session
         (AuthorizedTransaction, ExperienceSessionContext) and grant auditing. Story 19.2 kept this grant on
         purpose: removing it would mean publishing those security-sensitive internals as public API or
         duplicating them in a second package. -->
    <InternalsVisibleTo Include="AgentExperience.Storage.Postgres.Vectors" />
    <!-- Only so the vectors suite can set ExperienceEncryption.TestSuiteDefault and run a second time in
         encrypted mode (AGENTEXPERIENCE_TEST_ENCRYPTION); see that property. -->
    <InternalsVisibleTo Include="AgentExperience.Storage.Postgres.Vectors.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Story 11.2: the validation rules for the core storage ports, shared with AgentExperience.Storage.InMemory so
         both stores refuse exactly the same requests. The rules only this adapter has are in ExperienceRecordValidator.cs. -->
    <Compile Include="..\Shared\ExperienceRecordValidator.Shared.cs" Link="Shared\ExperienceRecordValidator.Shared.cs" />
    <!-- Story 17.1: the one rule that decides whether a reflection counts as model-authored, shared by Core, the MAF
         adapter and both stores so every authorship decision agrees. -->
    <Compile Include="..\Shared\ReflectionAuthorshipRule.Shared.cs" Link="Shared\ReflectionAuthorshipRule.Shared.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
