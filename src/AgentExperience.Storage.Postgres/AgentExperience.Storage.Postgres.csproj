<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Preview, not production ready. PostgreSQL adapter for AgentExperience.NET: persists canonical, scoped Experience Records through the IExperienceRecordStore port with plain Npgsql, host-authorization checks before any database access, exact scope predicates applied in SQL, and a journaled schema migration runner over embedded, versioned scripts. Pinned to Npgsql 10.0.3, dbup-postgresql 7.0.1, and dbup-core 6.1.1.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exact pin: verified against this version only (Story 1.7 Track 3, Story 2.1). -->
    <PackageReference Include="Npgsql" Version="[10.0.3]" />
    <!-- Exact pins: journaled schema migrations, verified against Npgsql 10.0.3 on 2026-09-17. -->
    <PackageReference Include="dbup-postgresql" Version="[7.0.1]" />
    <!-- dbup-postgresql's own dependency, pinned directly so the version is explicit. Bump the two DbUp pins
         in lockstep, to the dbup-core version the new dbup-postgresql depends on; DependencyBoundaryTests
         asserts this exact set of three PackageReferences. -->
    <PackageReference Include="dbup-core" Version="[6.1.1]" />
    <!-- DI abstractions only (no container, no hosting): lets this adapter ship its own
         AddAgentExperiencePostgresStore registration extension. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[10.0.11]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentExperience.Abstractions\AgentExperience.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\0001_create_experience_records.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0001_create_experience_records.sql" />
    <EmbeddedResource Include="Migrations\0002_create_lifecycle_events.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0002_create_lifecycle_events.sql" />
    <EmbeddedResource Include="Migrations\0003_add_experience_search.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0003_add_experience_search.sql" />
    <!-- 0004 is owned by AgentExperience.Storage.Postgres.Vectors, which applies it separately: it needs
         CREATE EXTENSION vector and must not become a startup requirement for text-only hosts. -->
    <EmbeddedResource Include="Migrations\0005_create_experience_grants.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0005_create_experience_grants.sql" />
    <EmbeddedResource Include="Migrations\0006_lifecycle_supersession_and_append_only.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0006_lifecycle_supersession_and_append_only.sql" />
    <EmbeddedResource Include="Migrations\0007_confidence_evidence.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0007_confidence_evidence.sql" />
    <EmbeddedResource Include="Migrations\0008_reuse_feedback.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0008_reuse_feedback.sql" />
    <EmbeddedResource Include="Migrations\0009_grant_access_log.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0009_grant_access_log.sql" />
    <EmbeddedResource Include="Migrations\0010_delete_and_expire.sql" LogicalName="AgentExperience.Storage.Postgres.Migrations.0010_delete_and_expire.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentExperience.Storage.Postgres.Tests" />
    <!-- The vectors package is the same adapter family, split out only because this package's
         dependency boundary forbids Pgvector and the model-provider abstractions it needs. It reuses
         this package's column list, scope predicate, row decoder, and failure translation so the two
         retrieval channels cannot drift apart. -->
    <InternalsVisibleTo Include="AgentExperience.Storage.Postgres.Vectors" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
