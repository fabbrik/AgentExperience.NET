<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Preview, not production ready. AgentExperience.NET's Core: sanitization (per-Kind allowlists, secret-field classification, recursive traversal, fail-closed rejection), in-memory run capture, deterministic verification, auditable reflection, finalization, lifecycle and confidence updates, indexing, bounded retrieval with explainable ranking, and reuse feedback, built on AgentExperience.Abstractions' ports. No dependency on MAF, EF Core, PostgreSQL, model providers, or OpenTelemetry -- only the BCL, Abstractions, Microsoft.Extensions.Compliance.Redaction, and Microsoft.Extensions.DependencyInjection.Abstractions (AD-1).</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Floors, not exact pins (story 6.3, KL-13): the version CI proves, and the lowest a host can resolve.
         CI's floating leg also proves the newest release in the same major; docs/compatibility-evidence.md
         states the policy. -->
    <PackageReference Include="Microsoft.Extensions.Compliance.Redaction" Version="10.10.0" />
    <!-- DI abstractions only (no container, no hosting): lets Core ship its own AddAgentExperienceCore
         registration extension. Abstractions stays BCL-only. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentExperience.Abstractions\AgentExperience.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only so the suite can prove EnvelopeExperienceKeyStore's batch fan-out disposes every key it obtained
         when one lookup fails: the keys it creates are otherwise unobservable. -->
    <InternalsVisibleTo Include="AgentExperience.Core.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);AGENTEXPERIENCE_CORE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared source (story 14.3): the model-authored content guard's patterns, linked into Core and the MAF
         adapter so both agree on what a link is. -->
    <Compile Include="..\Shared\ModelTextPatterns.Shared.cs" Link="Shared\ModelTextPatterns.Shared.cs" />
    <!-- Story 17.1: the one rule that decides whether a reflection counts as model-authored, shared by Core, the MAF
         adapter and both stores so every authorship decision agrees. -->
    <Compile Include="..\Shared\ReflectionAuthorshipRule.Shared.cs" Link="Shared\ReflectionAuthorshipRule.Shared.cs" />
    <!-- Story 18.1: the one rule that reduces a captured error to a short class, shared by the default reflector's
         lesson and the injected block's Tried: lines so both name a failure the same way. -->
    <Compile Include="..\Shared\ErrorClass.Shared.cs" Link="Shared\ErrorClass.Shared.cs" />
    <!-- Story 18.2: the default reflector's wording the compact block leaves out, written by one and matched by the other. -->
    <Compile Include="..\Shared\DefaultReflectionText.Shared.cs" Link="Shared\DefaultReflectionText.Shared.cs" />
  </ItemGroup>

</Project>
