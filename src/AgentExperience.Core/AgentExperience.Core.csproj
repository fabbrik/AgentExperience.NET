<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Preview, not production ready. AgentExperience.NET's Core: sanitization (per-Kind allowlists, secret-field classification, recursive traversal, fail-closed rejection), in-memory run capture, deterministic verification, auditable reflection, finalization, lifecycle and confidence updates, indexing, bounded retrieval with explainable ranking, and reuse feedback, built on AgentExperience.Abstractions' ports. No dependency on MAF, EF Core, PostgreSQL, model providers, or OpenTelemetry -- only the BCL, Abstractions, Microsoft.Extensions.Compliance.Redaction, and Microsoft.Extensions.DependencyInjection.Abstractions (AD-1), plus, on net8.0 only, System.Text.Json and Microsoft.Bcl.Memory for APIs the .NET 8 shared framework lacks.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Floors, not exact pins (story 6.3, KL-13): the version CI proves, and the lowest a host can resolve.
         CI's floating leg also proves the newest release in the same major; docs/compatibility-evidence.md
         states the policy. -->
    <PackageReference Include="Microsoft.Extensions.Compliance.Redaction" Version="10.10.0" />
    <!-- DI abstractions only (no container, no hosting): lets Core ship its own AddAgentExperienceCore
         registration extension. Abstractions stays BCL-only. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <!-- net8.0 only (story 7.2, KL-13): the .NET 8 shared framework lacks APIs Core compiles against, so the
       .NET 10 train's own out-of-band packages supply them, exactly as Microsoft.Extensions.AI and MAF do for
       their net8.0 builds. System.Text.Json for JsonElement.DeepEquals; Microsoft.Bcl.Memory for Base64Url.
       On net9.0 and net10.0 the shared framework has both, and nothing is referenced. Floors, like every
       other reference; docs/compatibility-evidence.md has the evidence rows. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentExperience.Abstractions\AgentExperience.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
