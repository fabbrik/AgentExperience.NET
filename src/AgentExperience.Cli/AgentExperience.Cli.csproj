<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Preview, not production ready. The aexp command: verified-lesson memory for any agent, not only Microsoft Agent Framework ones. One .NET tool that is both a CLI (aexp run start/call/end, finalize, recall, lessons, export, benefit) and an MCP stdio server (aexp mcp), over a local SQLite file by default or PostgreSQL. It drives the same library the MAF adapter uses: capture with sanitization, finalization against a verifier command the project's own config names, the Historical Reference block, recall by failure signature, the injection holdout, the lessons view and the measured export. It calls no model, never takes identity or scope from its arguments, and runs no command but the configured verifier. Install with dotnet tool install AgentExperience.Cli.</Description>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>aexp</ToolCommandName>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>$(PackageTags);mcp;cli;dotnet-tool;coding-agents</PackageTags>
    <RootNamespace>AgentExperience.Cli</RootNamespace>
  </PropertyGroup>

  <!-- Story 29.3: the self-contained, single-file binaries eng/publish-binaries.sh builds for the GitHub release (the
       path that needs no .NET). Both groups are conditional on AexpBinaries, which only that script sets: a tool
       project with plain RuntimeIdentifiers packs one tool package per runtime and strips the outer package (NU5017),
       and a locked restore (the release's) needs the runtimes' graphs in a lock file, so they get their own
       (packages.binaries.lock.json) and packages.lock.json stays the tool package's. A plain build, restore or pack
       sees none of this. No trimming or AOT: reflection-based JSON and Npgsql are not proven trim-safe.
       InvariantGlobalization is for the binaries only: a self-contained Linux app without it needs libicu on the host.
       AssemblyName stays (the tests' InternalsVisibleTo names it); the script renames the published file. -->
  <PropertyGroup Condition="'$(AexpBinaries)' == 'true'">
    <RuntimeIdentifiers>linux-x64;linux-arm64;osx-arm64;osx-x64;win-x64</RuntimeIdentifiers>
    <NuGetLockFilePath>packages.binaries.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AexpBinaries)' == 'true' And '$(AexpBinaryRuntime)' != ''">
    <RuntimeIdentifier>$(AexpBinaryRuntime)</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The official MCP C# SDK's core package only (stdio and stream transports, the low-level server and client): no
         hosting stack. A tool ships its own dependency graph, resolved once at pack time, so this floor is exactly what
         every installed copy runs. -->
    <PackageReference Include="ModelContextProtocol.Core" Version="2.3.0" />
    <!-- The container the tool builds the library in, once per command. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentExperience.MicrosoftAgentFramework\AgentExperience.MicrosoftAgentFramework.csproj" />
    <ProjectReference Include="..\AgentExperience.Storage.Sqlite\AgentExperience.Storage.Sqlite.csproj" />
    <ProjectReference Include="..\AgentExperience.Storage.Postgres\AgentExperience.Storage.Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentExperience.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
