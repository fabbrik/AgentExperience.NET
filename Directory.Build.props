<Project>

  <!-- The supported target framework: net10.0 only, by the maintainer's decision (see CHANGELOG), for every project
       in the repository: the six shipping packages, every test project, the end-to-end sample, the experiments and
       eng/verify-packages.cs (a file-based app that imports this file too). Stated once, here; the release tests check that
       CI, eng/verify-packages.cs and docs/compatibility-evidence.md agree with it. Supporting a second framework again
       means TargetFrameworks (plural) here. 0.1.0-preview.3 is the last release that also targets net8.0 and net9.0. -->
  <PropertyGroup>
    <AgentExperienceTargetFrameworks>net10.0</AgentExperienceTargetFrameworks>
    <TargetFramework>$(AgentExperienceTargetFrameworks)</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Generates packages.lock.json per project so CI's actions/setup-dotnet cache has a lock file to key on. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- Versioning. Set here, once, for all six packages. This is a PREVIEW: the version is deliberately
       not 1.0.0, because 1.0.0 is a stability promise this codebase declines to make while the Known
       limits table in docs/known-limits.md is non-empty (see RELEASING.md). Bump the suffix (preview.2, ...)
       for each preview; only a release that satisfies RELEASING.md's production-readiness gate may drop
       it. Without this property `dotnet pack` would silently emit 1.0.0. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.7</VersionSuffix>
  </PropertyGroup>

  <!-- Package metadata: applies to every packable project (the six under src/). -->
  <PropertyGroup>
    <Authors>AgentExperience.NET Contributors</Authors>
    <Company>AgentExperience.NET</Company>
    <Copyright>Copyright (c) AgentExperience.NET Contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/fabbrik/AgentExperience.NET</RepositoryUrl>
    <PackageProjectUrl>https://github.com/fabbrik/AgentExperience.NET</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>agents;ai;agent-memory;experience;microsoft-agent-framework;maf;postgresql;pgvector;preview</PackageTags>
    <PackageReleaseNotes>Preview release. Not production ready, and it claims no production readiness: the Known limits table lists every unresolved item, and any unresolved item blocks a production-readiness claim. The Documented boundaries table beside it states exactly what no code change can remove. Public APIs may change between previews. See https://github.com/fabbrik/AgentExperience.NET/blob/main/docs/known-limits.md</PackageReleaseNotes>
  </PropertyGroup>

  <!-- Symbols, SourceLink, and deterministic builds. The .NET SDK ships SourceLink for GitHub
       built in, so no package reference is needed: PublishRepositoryUrl stamps the repository URL and
       commit into the nuspec, EmbedUntrackedSources embeds generated sources in the PDB, and the PDB
       ships in a .snupkg next to each .nupkg with the same version. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <!-- The six shipping projects are exactly the ones under src/. -->
    <AgentExperienceShippingProject Condition="$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').Replace('\', '/').StartsWith('src/'))">true</AgentExperienceShippingProject>
  </PropertyGroup>

  <!-- Package validation: `dotnet pack` compares each shipping package with the same package at the last published
       preview, and fails on any binary break (a removed or re-shaped member, init to set, ...) that is not declared.
       The public API snapshots in AgentExperience.Release.Tests record the source shape; this records compatibility
       with what consumers already have. An intentional break is declared in the project's CompatibilitySuppressions.xml
       (regenerate it with -p:ApiCompatGenerateSuppressionFile=true, review the diff, and label the break in the
       CHANGELOG). After each release, set the baseline to that release and delete the suppression files (RELEASING.md);
       a release test holds this version to the CHANGELOG. Restore downloads the baseline packages from nuget.org. -->
  <PropertyGroup Condition="'$(AgentExperienceShippingProject)' == 'true'">
    <AgentExperiencePackageValidationBaseline>0.1.0-preview.7</AgentExperiencePackageValidationBaseline>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>$(AgentExperiencePackageValidationBaseline)</PackageValidationBaselineVersion>
  </PropertyGroup>

  <!-- ContinuousIntegrationBuild maps source paths to /_/ so the shipped assemblies and PDBs do not depend
       on where the repository was cloned. It is applied to the SHIPPING projects only, and never passed as
       a global -p:ContinuousIntegrationBuild=true: test projects locate checked-in files through
       [CallerFilePath], which the same mapping would turn into /_/... paths that do not exist. It is on in
       GitHub Actions, and a local release build turns it on with -p:AgentExperienceReleaseBuild=true
       (RELEASING.md), a property only this condition reads. -->
  <PropertyGroup Condition="'$(AgentExperienceShippingProject)' == 'true' And ('$(GITHUB_ACTIONS)' == 'true' Or '$(AgentExperienceReleaseBuild)' == 'true')">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
