<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Generates packages.lock.json per project so CI's actions/setup-dotnet cache has a lock file to key on. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- Package metadata: applies to every packable project (Abstractions today; Core and adapters as they are added). -->
  <PropertyGroup>
    <Authors>AgentExperience.NET Contributors</Authors>
    <Company>AgentExperience.NET</Company>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/fabbrik/AgentExperience.NET</RepositoryUrl>
    <PackageProjectUrl>https://github.com/fabbrik/AgentExperience.NET</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
