<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);AGENTEXPERIENCE_MAF_TESTS</DefineConstants>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Not packed/consumed, so missing XML doc comments on [Fact] methods aren't meaningful here. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test-only: a real container, so AddAgentExperienceChatClientReflector is resolved rather than merely declared. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AgentExperience.Abstractions" />
    <Using Include="AgentExperience.Core.Capture" />
    <Using Include="AgentExperience.Core.Sanitization" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentExperience.MicrosoftAgentFramework\AgentExperience.MicrosoftAgentFramework.csproj" />
    <!-- Story 14.4: the model-authored exclusion is proved through injection over a real store, the in-memory one. -->
    <ProjectReference Include="..\..\src\AgentExperience.Storage.InMemory\AgentExperience.Storage.InMemory.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Story 17.2: signs records from the documented canonical encodings, independently of Core's internal signer. -->
    <Compile Include="..\Shared\SignedRecords.cs" Link="Shared\SignedRecords.cs" />
    <!-- Story 21.3: a deterministic embedding generator, for the semantic retrieval wiring; never a quality measure. -->
    <Compile Include="..\Shared\ConceptEmbeddingGenerator.cs" Link="Shared\ConceptEmbeddingGenerator.cs" />
    <!-- The README's first screen: its length and the excerpt rule, shared with the end-to-end sample tests. -->
    <Compile Include="..\Shared\ReadmeFirstScreen.cs" Link="Shared\ReadmeFirstScreen.cs" />
    <!-- Story 18.1: the error classifier is shared source linked into Core and the MAF adapter; its tests run
         against both copies. -->
    <Compile Include="..\AgentExperience.Core.Tests\ErrorClassTests.cs" Link="Shared\ErrorClassTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The README's first-screen setup is ReadmeQuickStart.cs, compiled here; ReadmeQuickStartTests checks that the
         README shows it verbatim. Both are embedded so the check does not depend on where the repository is at test time. -->
    <EmbeddedResource Include="ReadmeQuickStart.cs" LogicalName="AgentExperience.MicrosoftAgentFramework.Tests.ReadmeQuickStart.cs" />
    <EmbeddedResource Include="..\..\README.md" LogicalName="AgentExperience.MicrosoftAgentFramework.Tests.RootREADME.md" />
  </ItemGroup>

</Project>
