<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AgentExperience.RetrievalQuality</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Not packed/consumed, so missing XML doc comments on [Fact] methods aren't meaningful here. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="[17.14.1]" />
    <PackageReference Include="xunit" Version="[2.9.3]" />
    <PackageReference Include="xunit.runner.visualstudio" Version="[3.1.4]" />
    <!-- Ephemeral stock postgres container (Docker required; the major AGENTEXPERIENCE_POSTGRES_MAJOR selects), for the
         PostgreSQL golden only. Text search needs nothing pgvector provides, so the stock image is enough. Same pin as
         AgentExperience.Sample.EndToEnd.Tests. -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="[4.15.0]" />
  </ItemGroup>

  <ItemGroup>
    <!-- Linked, so no test project references another: the conformance suite's record builder every corpus record is
         made from, and the PostgreSQL major this run starts (story 6.3). -->
    <Compile Include="..\AgentExperience.Storage.Conformance\ConformanceData.cs" Link="Shared\ConformanceData.cs" />
    <Compile Include="..\Shared\PostgresTestImage.cs" Link="Shared\PostgresTestImage.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AgentExperience.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentExperience.Storage.InMemory\AgentExperience.Storage.InMemory.csproj" />
    <ProjectReference Include="..\..\src\AgentExperience.Storage.Postgres\AgentExperience.Storage.Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The corpus: experience records and labelled queries, written before the first run and never tuned to it. -->
    <EmbeddedResource Include="Corpus\records.json" LogicalName="AgentExperience.RetrievalQuality.Corpus.records.json" />
    <EmbeddedResource Include="Corpus\queries.json" LogicalName="AgentExperience.RetrievalQuality.Corpus.queries.json" />
    <!-- One checked-in report per adapter, compared byte for byte. Embedded so the comparison does not depend on where
         the repository root is at test time; one file per adapter, so a run without Docker still checks the in-memory
         one. -->
    <EmbeddedResource Include="GoldenInMemoryReport.txt" LogicalName="AgentExperience.RetrievalQuality.GoldenInMemoryReport.txt" />
    <EmbeddedResource Include="GoldenPostgresReport.txt" LogicalName="AgentExperience.RetrievalQuality.GoldenPostgresReport.txt" />
  </ItemGroup>

</Project>
