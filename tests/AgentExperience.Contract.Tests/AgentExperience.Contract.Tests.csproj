<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Not packed/consumed, so missing XML doc comments on [Fact] methods aren't meaningful here. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Validates every expected record against contract/schema/experience-record.v1.json with a real JSON Schema
         (draft 2020-12) evaluator, not a hand-written check. Test-only. -->
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <!-- The search fixtures run against a schema the .NET migrator applied, in an ephemeral stock postgres container
         (Docker required; the major AGENTEXPERIENCE_POSTGRES_MAJOR selects). -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\PostgresTestImage.cs" Link="Shared\PostgresTestImage.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The reference implementation the contract is generated from and checked against: capture, finalization and
         the default reflector (Core), the stored format (Storage.Postgres), the injected block and the task text (the
         MAF adapter), and the in-memory store the finalize cases commit through. -->
    <ProjectReference Include="..\..\src\AgentExperience.Core\AgentExperience.Core.csproj" />
    <ProjectReference Include="..\..\src\AgentExperience.MicrosoftAgentFramework\AgentExperience.MicrosoftAgentFramework.csproj" />
    <ProjectReference Include="..\..\src\AgentExperience.Storage.InMemory\AgentExperience.Storage.InMemory.csproj" />
    <ProjectReference Include="..\..\src\AgentExperience.Storage.Postgres\AgentExperience.Storage.Postgres.csproj" />
  </ItemGroup>

</Project>
