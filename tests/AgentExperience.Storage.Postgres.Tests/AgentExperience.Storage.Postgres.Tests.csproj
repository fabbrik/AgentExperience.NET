<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Not packed/consumed, so missing XML doc comments on [Fact] methods aren't meaningful here. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Test-only: a real container, so the package's own AddAgentExperience... registrations are
         resolved rather than merely declared. The shipping package takes only the DI abstractions. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <!-- Ephemeral pgvector/pgvector container (Docker required), at the PostgreSQL major
         AGENTEXPERIENCE_POSTGRES_MAJOR selects (16 by default). Pin verified 2026-09-15. -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The PostgreSQL major this run starts, from AGENTEXPERIENCE_POSTGRES_MAJOR (story 6.3). Linked, so no
         test project references another. -->
    <Compile Include="..\Shared\PostgresTestImage.cs" Link="Shared\PostgresTestImage.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AgentExperience.Abstractions" />
    <Using Include="AgentExperience.Core.Capture" />
    <Using Include="AgentExperience.Core.Finalization" />
    <Using Include="AgentExperience.Core.Lifecycle" />
    <Using Include="AgentExperience.Core.Reflections" />
    <Using Include="AgentExperience.Core.Sanitization" />
    <Using Include="AgentExperience.Core.Verification" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test-only migration scripts for the failing-script case, reached through the migrator's internal
         script-selection seam. A failing script must never ship in the package. -->
    <EmbeddedResource Include="FailingMigrations\0001_marker.sql" LogicalName="AgentExperience.Storage.Postgres.Tests.FailingMigrations.0001_marker.sql" />
    <EmbeddedResource Include="FailingMigrations\0002_broken.sql" LogicalName="AgentExperience.Storage.Postgres.Tests.FailingMigrations.0002_broken.sql" />
    <!-- Test-only scripts for the second-script case: a later script applies on top of an already-journaled
         one, and its $body$-quoted DO block only survives while DbUp variable substitution stays disabled. -->
    <EmbeddedResource Include="ExtraMigrations\0001_marker.sql" LogicalName="AgentExperience.Storage.Postgres.Tests.ExtraMigrations.0001_marker.sql" />
    <EmbeddedResource Include="ExtraMigrations\0002_dollar_quoted.sql" LogicalName="AgentExperience.Storage.Postgres.Tests.ExtraMigrations.0002_dollar_quoted.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- The end-to-end finalization test drives Core's capture and finalization services through the
         real store. The src-side dependency boundary is unaffected and still asserted by
         DependencyBoundaryTests. -->
    <ProjectReference Include="..\..\src\AgentExperience.Core\AgentExperience.Core.csproj" />
    <ProjectReference Include="..\..\src\AgentExperience.Storage.Postgres\AgentExperience.Storage.Postgres.csproj" />
  </ItemGroup>

</Project>
