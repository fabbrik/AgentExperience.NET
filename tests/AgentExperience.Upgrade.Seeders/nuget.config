<?xml version="1.0" encoding="utf-8"?>
<!-- Story 12.1: the seeders restore the PUBLISHED previews' packages, and only from nuget.org. Clearing every inherited
     source and mapping every package to nuget.org means a machine-wide or user-level feed can never substitute a
     package of the same ID and version (a locally packed AgentExperience.* build, for example). The committed lock
     files pin each package's content hash as well. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
