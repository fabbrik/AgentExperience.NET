<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Release gates, not library behaviour: the public API baseline, the compatibility proof's
         agreement with the shipping pins, and the consolidated security-suite map. -->
    <!-- Not packed/consumed, so missing XML doc comments on [Fact] methods aren't meaningful here. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="[17.14.1]" />
    <PackageReference Include="xunit" Version="[2.9.3]" />
    <PackageReference Include="xunit.runner.visualstudio" Version="[3.1.4]" />
    <!-- Test-only (story 4.3, AD-B): the approval baseline of the five shipping assemblies' public
         surface. No shipping project references either package. -->
    <PackageReference Include="PublicApiGenerator" Version="[11.5.4]" />
    <PackageReference Include="Verify.Xunit" Version="[31.12.5]" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentExperience.Abstractions\AgentExperience.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\AgentExperience.Core\AgentExperience.Core.csproj" />
    <ProjectReference Include="..\..\src\AgentExperience.MicrosoftAgentFramework\AgentExperience.MicrosoftAgentFramework.csproj" />
    <ProjectReference Include="..\..\src\AgentExperience.Storage.Postgres\AgentExperience.Storage.Postgres.csproj" />
    <ProjectReference Include="..\..\src\AgentExperience.Storage.Postgres.Vectors\AgentExperience.Storage.Postgres.Vectors.csproj" />
  </ItemGroup>

</Project>
