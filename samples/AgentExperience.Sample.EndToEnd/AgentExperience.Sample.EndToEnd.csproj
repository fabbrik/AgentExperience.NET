<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AgentExperience.Sample.EndToEnd</RootNamespace>
    <!-- A demonstration, never a package: shipping an in-memory record store from a published
         package would invite someone to run it in production. -->
    <IsPackable>false</IsPackable>
    <!-- Directory.Build.props turns on GenerateDocumentationFile with TreatWarningsAsErrors, which
         would make every undocumented public member a build error. The sample documents the types a
         reader is meant to follow, not every member of them. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The container itself (Core and the adapters reference only the DI abstractions), so the
         sample can show the same registration calls a host would make. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="[10.0.12]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentExperience.Core\AgentExperience.Core.csproj" />
    <ProjectReference Include="..\..\src\AgentExperience.MicrosoftAgentFramework\AgentExperience.MicrosoftAgentFramework.csproj" />
    <ProjectReference Include="..\..\src\AgentExperience.Storage.Postgres\AgentExperience.Storage.Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so the sample's own test can scan it for improvement claims without knowing where
         the repository root is at test time. -->
    <EmbeddedResource Include="README.md" LogicalName="AgentExperience.Sample.EndToEnd.README.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentExperience.Sample.EndToEnd.Tests" />
    <!-- Story 4.4's measurement harness reuses this sample's three in-memory port doubles and its
         attempt-level tool recorder rather than copying them. It deliberately does not reuse the
         stepping clock or the counter-based identifier source: see ReuseBaselineExperiment. -->
    <InternalsVisibleTo Include="AgentExperience.ReuseBaseline" />
    <!-- Story 9.1's live-model experiment reuses the same doubles, for the same reason. -->
    <InternalsVisibleTo Include="AgentExperience.LiveReuse" />
  </ItemGroup>

</Project>
