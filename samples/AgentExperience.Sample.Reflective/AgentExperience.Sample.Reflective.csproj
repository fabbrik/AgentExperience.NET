<Project Sdk="Microsoft.NET.Sdk">

  <!-- Reflective execution (experimental) in two runs: a coding agent whose first attempt fails and is corrected, then a
       related task that is handed what the first run learned. Run it with dotnet run (see README.md): it needs no key and
       no network, and a real IChatClient can replace the scripted model in Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AgentExperience.Sample.Reflective</RootNamespace>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="[10.0.12]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentExperience.MicrosoftAgentFramework\AgentExperience.MicrosoftAgentFramework.csproj" />
    <ProjectReference Include="..\..\src\AgentExperience.Storage.InMemory\AgentExperience.Storage.InMemory.csproj" />
  </ItemGroup>

</Project>
