<Project Sdk="Microsoft.NET.Sdk">

  <!-- Story 9.1: the live-model reuse experiment. A console app, not a test project, so `dotnet test` over the
       solution never runs it and never spends money: it runs only when someone types
       the explicit `dotnet run` command in README.md, and it skips with a message when no provider
       variables are set. It sits outside src/ and tests/, so Directory.Build.props gives it net10.0 only. Its
       harness is proven offline by experiments/AgentExperience.LiveReuse.Tests, which IS part of the normal suite. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AgentExperience.LiveReuse</RootNamespace>
    <!-- An experiment, never a package. -->
    <IsPackable>false</IsPackable>
    <!-- Directory.Build.props turns on GenerateDocumentationFile with TreatWarningsAsErrors; the experiment documents
         the types a reader has to follow to check a number, not every member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The ONLY provider package, exact-pinned, and only here: never in src/, whose dependency-boundary tests
         forbid provider packages by name. One package reaches both providers through their OpenAI-compatible
         Chat Completions endpoints (Gemini: generativelanguage.googleapis.com/v1beta/openai/; Azure OpenAI: the v1
         endpoint, <resource>/openai/v1/), so the experiment code sees only IChatClient. 10.10.0 is chosen because it
         depends on Microsoft.Extensions.AI.Abstractions 10.10.0, exactly the shipping floor, so the graph is not lifted
         above what src/ declares. It brings OpenAI 2.13.0 and System.ClientModel transitively. The comparison with
         Google.GenAI and Azure.AI.OpenAI is in README.md ("Provider integration"). -->
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="[10.10.0]" />
    <!-- The container, so each trial is composed the way a host composes one. Same pin as the sample and 4.4. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="[10.0.12]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentExperience.Core\AgentExperience.Core.csproj" />
    <ProjectReference Include="..\..\src\AgentExperience.MicrosoftAgentFramework\AgentExperience.MicrosoftAgentFramework.csproj" />
    <!-- The 4.2 sample's in-memory port doubles, reused rather than copied, exactly as story 4.4 does. -->
    <ProjectReference Include="..\..\samples\AgentExperience.Sample.EndToEnd\AgentExperience.Sample.EndToEnd.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so the harness reads the exact bytes it was built with, and reports their git blob id. -->
    <EmbeddedResource Include="preregistration.json" LogicalName="AgentExperience.LiveReuse.preregistration.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentExperience.LiveReuse.Tests" />
  </ItemGroup>

</Project>
